ANTHROPIC_BASE_URL="xxx"
ANTHROPIC_AUTH_TOKEN="xxxx"
DEFAULT_ANTHROPIC_MODEL="claude-haiku-5-5"

OPENAI_BASE_URL="xxx"
OPENAI_AUTH_TOKEN="xxxx"
DEFAULT_OPENAI_MODEL="gpt-6.1-sol"

# Cloudflare Access (self-hosted app on the production hostname)
ACCESS_TEAM_DOMAIN="https://<team>.cloudflareaccess.com"
ACCESS_AUD="<application AUD tag>"

# Google OAuth web client (Drive)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="xxxx"
