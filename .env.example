# Chat models are not set here: the admin adds shared providers in the admin page (/admin/models), and each user can
# sign in to their own in Settings → Models.
# Seals shared-provider keys, plugin/channel keys, model credentials, webhook secrets and MCP headers/OAuth tokens.
# 32 random bytes, base64: openssl rand -base64 32. Keep it stable: changing it makes every sealed secret unreadable.
TOKEN_ENCRYPTION_KEY="xxxx"

# Public web origin: required for Feishu cards and MCP OAuth callbacks (/api/users/<userId>/mcp/callback).
# Feishu App ID / App Secret are configured in the channels page and stored encrypted.
PUBLIC_URL="https://bot.example.com"

# Trust the rightmost X-Forwarded-For hop for share-read limits only behind an appending reverse proxy.
# Production Compose enables this for Caddy; direct development servers keep it disabled.
GENSE_TRUST_PROXY="0"

# DeepSeek search / fetch: the server default for the web plugin (a key can also be set in the page).
DEEPSEEK_API_KEY="sk-xxx"
# The image plugin's default endpoint (optional; a key can also be set in the plugin page).
PROVIDER_BASE_URL="xxx"
PROVIDER_AUTH_TOKEN="xxxx"

# Self-hosted sandbox for `bash` (Docker; build the images with npm run sandbox:build). SANDBOX=0 turns it off.
SANDBOX="1"
SANDBOX_MEMORY="1g"
SANDBOX_CPUS="2"
SANDBOX_IDLE_MINUTES="15"

# Data directory: accounts, sessions, shared providers and usage in app.sqlite; each user's conversations and
# pi-durable state in users/<userId>/space.sqlite, their files in users/<userId>/files/; copies under backups/.
# Relative paths are from the repository root. BACKUPS=0 turns the daily copies off; BACKUP_KEEP is how many to keep.
DATA_DIR="data"
BACKUP_KEEP="7"

# Docker Compose deployment only (compose.yaml). GENSE_DATA is an absolute path on the VPS; it replaces DATA_DIR there.
GENSE_DOMAIN="bot.example.com"
GENSE_DATA="/srv/gense/data"
# id -u / id -g of the owner of GENSE_DATA, and the group of the Docker socket: stat -c %g /var/run/docker.sock
GENSE_UID="1000"
GENSE_GID="1000"
DOCKER_GID="999"
