PROVIDER_BASE_URL="xxx"
PROVIDER_AUTH_TOKEN="xxxx"
DEFAULT_PROVIDER_MODEL="gpt-6-luna"
PROVIDER_PROTOCAL="openai-responses"
# Cloudflare Access (optional since roadmap 3; login is email + password)
ACCESS_TEAM_DOMAIN="https://<team>.cloudflareaccess.com"
ACCESS_AUD="<application AUD tag>"

# Google OAuth web client (Drive)
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"

# Seals users' plugin keys. 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="xxxx"

# DeepSeek search / fetch: the server default for the web plugin (users may set their own key).
# The image plugin defaults to PROVIDER_BASE_URL / PROVIDER_AUTH_TOKEN.
DEEPSEEK_API_KEY="sk-xxx"
