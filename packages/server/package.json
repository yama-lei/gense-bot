{
  "name": "@gense/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/plugins/catalog.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/platform/main.ts",
    "start": "node --env-file-if-exists=../../.env src/platform/main.ts",
    "test": "mkdir -p ../../data/test-tmp && TMPDIR=\"$PWD/../../data/test-tmp\" node --test test/*.test.ts",
    "passwd": "node --env-file-if-exists=../../.env src/platform/passwd.ts",
    "user:import-owner": "node --env-file-if-exists=../../.env src/platform/user-cli.ts import-owner",
    "user:admin": "node --env-file-if-exists=../../.env src/platform/user-cli.ts admin"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@gense/protocol": "*",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openuidev/lang-core": "1.0.0",
    "fflate": "0.8.3",
    "typebox": "1.3.27",
    "unpdf": "1.8.1",
    "ws": "8.18.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.1"
  }
}
