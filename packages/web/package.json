{
  "name": "@gense/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "preview": "vite preview",
    "genui": "vite build --ssr scripts/genui.ts --outDir node_modules/.genui --emptyOutDir --logLevel warn && node node_modules/.genui/genui.js ../core/src/plugins/genui/generated.ts",
    "genui:check": "vite build --ssr scripts/genui.ts --outDir node_modules/.genui --emptyOutDir --logLevel warn && node node_modules/.genui/genui.js ../core/src/plugins/genui/generated.ts --check"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@gense/protocol": "*",
    "@openuidev/lang-core": "1.0.0",
    "@openuidev/react-lang": "1.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "0.19.0",
    "lucide-react": "1.54.0",
    "maplibre-gl": "6.13.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
